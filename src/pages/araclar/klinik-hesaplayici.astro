---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { href, weekHref } from '@/lib/site';
const app = href('/araclar/klinik-hesaplayici.html');
const source = 'https://github.com/drferhatu/yapay-zeka-ve-saglik/blob/main/public/araclar/klinik-hesaplayici.html';
---
<BaseLayout title="Klinik Hesaplayıcı" description="VKİ ve bel/boy oranı, eGFR (CKD-EPI 2021), CHA₂DS₂-VASc, Wells DVT ve mg/kg doz hesaplayıcı; tek dosya, kaynaklarıyla.">
  <div class="wrap py-10 md:py-12">
    <nav aria-label="Konum" class="text-sm text-ink-3"><a href={href('/araclar')} class="hover:text-ink">Araçlar</a> <span aria-hidden="true">/</span> Klinik Hesaplayıcı</nav>
    <div class="mt-4 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="display text-3xl md:text-4xl">Klinik Hesaplayıcı</h1>
        <p class="mt-2 max-w-2xl text-ink-2">Beş hesaplama, tek HTML dosyası, dış bağımlılık yok. 2. haftada tek bir istemle yazdırıldı; formüller ve eşikler kaynaklarıyla doğrulandı.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href={app} target="_blank" rel="noopener" class="btn-primary">Tam ekran aç</a>
        <a href={source} target="_blank" rel="noopener" class="btn-ghost">Kodu oku</a>
        <a href={weekHref(2)} class="btn-ghost">Nasıl yazdırıldı?</a>
      </div>
    </div>
  </div>
  <div class="wrap pb-20">
    <iframe src={app} title="Klinik Hesaplayıcı uygulaması" class="h-[82vh] min-h-[640px] w-full rounded-2xl border border-line bg-white shadow-soft" loading="lazy"></iframe>
    <p class="mt-4 text-xs text-ink-3">Eğitim amaçlıdır; klinik karar için tek başına kullanılmaz. Hata bulursanız derste söyleyin, birlikte düzelttiririz: bu da dersin parçası.</p>
  </div>
</BaseLayout>
