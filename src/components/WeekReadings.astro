---
/** Haftanın makalesi ve haftanın tartışması; NotebookLM çalışma kutusuyla. */
interface Reading { title: string; authors: string; source: string; year: number; url: string; doi?: string; kind?: string;
  summary: string[]; whyRead: string; questions: string[]; notebooklm?: string; }
interface Props { article?: Reading; discussion?: Reading; week: number; }
const { article, discussion, week } = Astro.props;
const items = [
  article && { key: 'makale', label: 'Haftanın makalesi', r: article, tone: 'brand' },
  discussion && { key: 'tartisma', label: 'Haftanın tartışması', r: discussion, tone: 'accent' },
].filter(Boolean) as { key: string; label: string; r: Reading; tone: string }[];
const nlm = items.filter((i) => i.r.notebooklm);
---
{items.length > 0 && (
<section aria-labelledby="okumalar" class="not-prose my-14">
  <div class="mb-6">
    <p class="eyebrow">Okuma</p>
    <h2 id="okumalar" class="display mt-1 text-2xl md:text-3xl">Bu haftanın okumaları</h2>
    <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-ink-2">Her hafta bir makale ve bir tartışma yazısı seçiyorum. Özetleri burada; ama özet okumak makale okumak değildir, tam metne gitmenizi ve aşağıdaki sorularla NotebookLM'de çalışmanızı istiyorum.</p>
  </div>

  <div class="grid gap-5 lg:grid-cols-2">
    {items.map(({ key, label, r, tone }) => (
      <article id={key} class="flex flex-col rounded-2xl border border-line bg-white p-6 shadow-soft" style={`border-top: 4px solid var(--color-${tone})`}>
        <p class="text-xs font-bold uppercase tracking-[0.12em]" style={`color: var(--color-${tone})`}>{label}{r.kind && <span class="font-medium normal-case tracking-normal text-ink-3"> · {r.kind}</span>}</p>
        <h3 class="mt-2 font-display text-xl font-semibold leading-snug text-ink">{r.title}</h3>
        <p class="mt-1 text-sm text-ink-2">{r.authors}</p>
        <p class="text-xs text-ink-3">{r.source}, {r.year}{r.doi && <span> · DOI {r.doi}</span>}</p>
        <div class="mt-4 space-y-3 text-[15px] leading-relaxed text-ink-2">
          {r.summary.map((par) => <p>{par}</p>)}
        </div>
        <div class="mt-4 rounded-xl bg-paper-2/70 p-4 text-[14px] leading-relaxed text-ink">
          <p class="text-xs font-bold uppercase tracking-[0.12em] text-ink-3">Bu hafta neden bu metin?</p>
          <p class="mt-1.5">{r.whyRead}</p>
        </div>
        {r.questions.length > 0 && (
          <div class="mt-4">
            <p class="text-xs font-bold uppercase tracking-[0.12em] text-ink-3">Okurken düşünün</p>
            <ol class="mt-2 list-decimal space-y-1.5 pl-5 text-[14px] leading-relaxed text-ink-2">{r.questions.map((q) => <li>{q}</li>)}</ol>
          </div>
        )}
        <a href={r.url} target="_blank" rel="noopener" class="mt-5 inline-flex w-fit items-center gap-2 rounded-full border border-line-2 bg-white px-4 py-2 text-sm font-semibold !text-ink !no-underline hover:border-ink hover:bg-paper-2">Tam metni aç <span aria-hidden="true">↗</span></a>
      </article>
    ))}
  </div>

  {nlm.length > 0 && (
    <div class="mt-6 rounded-2xl border border-dashed border-line-2 bg-paper-2/50 p-6">
      <p class="text-xs font-bold uppercase tracking-[0.12em] text-ink-3">NotebookLM ile çalışın</p>
      <p class="mt-2 text-[15px] leading-relaxed text-ink-2">
        <a href="https://notebooklm.google.com" target="_blank" rel="noopener" class="font-semibold !text-brand">NotebookLM</a>'de yeni bir defter açın, yukarıdaki bağlantıları (ya da indirdiğiniz PDF'leri) kaynak olarak ekleyin ve aşağıdaki istemi yapıştırın.
        NotebookLM yalnızca yüklediğiniz kaynaklardan cevap verir ve her cümlesine kaynağını iliştirir; bu yüzden özet çıkarmak, soru sormak ve kendinizi sınamak için sohbet botlarından daha güvenli bir yer.
      </p>
      <div class="mt-4 grid gap-3 md:grid-cols-2">
        {nlm.map(({ label, r }) => (
          <div class="rounded-xl border border-line bg-white p-4">
            <p class="text-xs font-semibold text-ink-3">{label} için istem</p>
            <pre class="mt-2 whitespace-pre-wrap rounded-lg bg-paper-2 p-3 font-mono text-[12.5px] leading-relaxed text-ink">{r.notebooklm}</pre>
          </div>
        ))}
      </div>
      <p class="mt-3 text-xs text-ink-3">İpucu: İki kaynağı aynı deftere yükleyip "bu iki metin birbirine nerede katılıyor, nerede ayrılıyor?" diye sorun; haftanın tartışma sorusu çoğu zaman tam orada çıkar.</p>
    </div>
  )}
</section>
)}
